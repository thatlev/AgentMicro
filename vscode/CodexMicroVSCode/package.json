{
  "name": "codex-micro-vscode",
  "displayName": "AgentMicro — VS Code bridge",
  "description": "Lets the AgentMicro iPhone control surface (via codexbridge --target vscode) drive editor tabs and agent terminals: focus a pinned tab, approve/reject Claude diffs, and send keys to Codex/Kimi CLIs.",
  "version": "0.6.0",
  "publisher": "codexmicro",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "scripts": { "test": "node --test test/*.test.js" },
  "contributes": {
    "commands": [
      {
        "command": "codexMicro.showStatus",
        "title": "AgentMicro: Show bridge status"
      }
    ],
    "colors": [
      {
        "id": "codexMicro.statusIdle",
        "description": "AgentMicro idle agent tab color.",
        "defaults": { "dark": "#FFFFFF", "light": "#5B616B", "highContrast": "#FFFFFF", "highContrastLight": "#1F2328" }
      },
      {
        "id": "codexMicro.statusWorking",
        "description": "AgentMicro working agent tab color.",
        "defaults": { "dark": "#5B7CFF", "light": "#304FFE", "highContrast": "#6C8AFF", "highContrastLight": "#2038B8" }
      },
      {
        "id": "codexMicro.statusComplete",
        "description": "AgentMicro completed agent tab color.",
        "defaults": { "dark": "#00D941", "light": "#087A30", "highContrast": "#20F060", "highContrastLight": "#076427" }
      },
      {
        "id": "codexMicro.statusNeedsInput",
        "description": "AgentMicro needs-input agent tab color.",
        "defaults": { "dark": "#FFAA2B", "light": "#A85A00", "highContrast": "#FFC266", "highContrastLight": "#7A4100" }
      },
      {
        "id": "codexMicro.statusError",
        "description": "AgentMicro failed agent tab color.",
        "defaults": { "dark": "#FF4968", "light": "#C41436", "highContrast": "#FF6B83", "highContrastLight": "#A30F2B" }
      }
    ],
    "configuration": {
      "title": "AgentMicro bridge",
      "properties": {
        "codexMicro.socketPath": {
          "type": "string",
          "default": "",
          "description": "Unix socket the extension listens on for codexbridge. Empty uses $TMPDIR/codexbridge-vscode.sock (falls back to /tmp)."
        },
        "codexMicro.terminalApprove": {
          "type": "string",
          "default": "y\n",
          "description": "Text sent to an agent TERMINAL target on an Approve press (Codex/Kimi CLIs). Use \\n for Enter."
        },
        "codexMicro.terminalReject": {
          "type": "string",
          "default": "n\n",
          "description": "Text sent to an agent TERMINAL target on a Reject press."
        },
        "codexMicro.terminalSubmit": {
          "type": "string",
          "default": "\n",
          "description": "Text sent to an agent TERMINAL target on a Submit (Codex key) press."
        },
        "codexMicro.decorateTabs": {
          "type": "boolean",
          "default": true,
          "description": "Color pinned file-editor tab labels from AgentMicro agent status. Selected tabs keep the normal VS Code selected color."
        }
      }
    }
  }
}
